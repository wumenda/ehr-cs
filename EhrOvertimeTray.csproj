<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EhrOvertimeTray</AssemblyName>
    <RootNamespace>EhrOvertimeTray</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- 构建后校验 HtmlTemplate.cs 内嵌面板 JS 语法（防回归）。
       node 未安装时自动跳过；可用 dotnet build -p:SkipPanelJsCheck=true 关闭。 -->
  <Target Name="CheckPanelJs" AfterTargets="Build" Condition="'$(SkipPanelJsCheck)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\check_panel_js.ps1&quot; &quot;$(IntermediateOutputPath)&quot;" />
  </Target>

</Project>